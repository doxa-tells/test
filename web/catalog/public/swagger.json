{
    "openapi": "3.1.0",
    "info": {
        "title": "Catalog API",
        "version": "1.0.0",
        "description": "Interactive documentation for the Catalog backend. Generated for Swagger UI."
    },
    "servers": [
        {
            "url": "/api"
        }
    ],
    "paths": {
        "/auth/login": {
            "post": {
                "summary": "User login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "email",
                                    "password"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "ok": {
                                            "type": "boolean"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "summary": "User logout",
                "responses": {
                    "200": {
                        "description": "Logout successful"
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "summary": "Register new user",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string"
                                    },
                                    "company": {
                                        "type": "string"
                                    },
                                    "role": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "email",
                                    "password",
                                    "company"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Registration successful"
                    },
                    "400": {
                        "description": "Bad request"
                    },
                    "409": {
                        "description": "User already exists"
                    }
                }
            }
        },
        "/actor-link": {
            "get": {
                "summary": "Get linked actor ID",
                "responses": {
                    "200": {
                        "description": "Returns actor_user_id",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "ok": {
                                            "type": "boolean"
                                        },
                                        "actor_user_id": {
                                            "type": [
                                                "integer",
                                                "null"
                                            ]
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            },
            "post": {
                "summary": "Link current user to an actor",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "actor_user_id": {
                                        "type": "integer"
                                    }
                                },
                                "required": [
                                    "actor_user_id"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Link saved"
                    },
                    "400": {
                        "description": "Bad request"
                    },
                    "401": {
                        "description": "Unauthorized"
                    }
                }
            }
        },
        "/actors/search": {
            "get": {
                "summary": "Search actors",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Search results",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "ok": {
                                            "type": "boolean"
                                        },
                                        "items": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "user_id": {
                                                        "type": "integer"
                                                    },
                                                    "full_name": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/actors/castings/{id}": {
            "get": {
                "summary": "Get casting detail",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Casting data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "ok": {
                                            "type": "boolean"
                                        },
                                        "casting": {
                                            "type": "object"
                                        },
                                        "company": {
                                            "type": [
                                                "object",
                                                "null"
                                            ]
                                        },
                                        "avatar_url": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "prefs": {
                                            "type": [
                                                "object",
                                                "null"
                                            ]
                                        },
                                        "portfolio": {
                                            "type": "array"
                                        },
                                        "owner": {
                                            "type": "boolean"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not found"
                    }
                }
            }
        },
        "/favorites": {
            "get": {
                "summary": "List favourite actors",
                "responses": {
                    "200": {
                        "description": "Favourite list",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "ok": {
                                            "type": "boolean"
                                        },
                                        "items": {
                                            "type": "array"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Add favourite",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "actor_user_id": {
                                        "type": "integer"
                                    }
                                },
                                "required": [
                                    "actor_user_id"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Added"
                    }
                }
            },
            "delete": {
                "summary": "Remove favourite",
                "parameters": [
                    {
                        "name": "actor",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Removed"
                    }
                }
            }
        },
        "/prefs": {
            "get": {
                "summary": "Get UI preferences",
                "responses": {
                    "200": {
                        "description": "Preferences object"
                    }
                }
            },
            "post": {
                "summary": "Update UI preferences",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Saved"
                    }
                }
            }
        },
        "/public-actors": {
            "get": {
                "summary": "Public actors list",
                "responses": {
                    "200": {
                        "description": "Array of actors"
                    }
                }
            }
        },
        "/public/castings": {
            "get": {
                "summary": "Public castings list",
                "responses": {
                    "200": {
                        "description": "Array of castings"
                    }
                }
            }
        },
        "/public/castings/{id}": {
            "get": {
                "summary": "Public casting detail",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Casting data"
                    }
                }
            }
        },
        "/settings/account/email": {
            "get": {
                "summary": "Get user email",
                "responses": {
                    "200": {
                        "description": "Email object"
                    }
                }
            },
            "post": {
                "summary": "Update email",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "email"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Updated"
                    }
                }
            }
        },
        "/settings/account/password": {
            "post": {
                "summary": "Change password",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "current": {
                                        "type": "string"
                                    },
                                    "new": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "current",
                                    "new"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password changed"
                    }
                }
            }
        },
        "/settings/company": {
            "get": {
                "summary": "Get company info",
                "responses": {
                    "200": {
                        "description": "Company object"
                    }
                }
            },
            "post": {
                "summary": "Update company",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "role": {
                                        "type": "string"
                                    },
                                    "bio": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Saved"
                    }
                }
            }
        },
        "/settings/avatar": {
            "get": {
                "summary": "Get avatar URL",
                "responses": {
                    "200": {
                        "description": "URL"
                    }
                }
            },
            "post": {
                "summary": "Upload avatar (multipart)",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "file": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "required": [
                                    "file"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Uploaded"
                    }
                }
            },
            "delete": {
                "summary": "Delete avatar",
                "responses": {
                    "200": {
                        "description": "Deleted"
                    }
                }
            }
        },
        "/settings/prefs": {
            "get": {
                "summary": "Get settings preferences",
                "responses": {
                    "200": {
                        "description": "Prefs object"
                    }
                }
            },
            "post": {
                "summary": "Update settings prefs",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Saved"
                    }
                }
            }
        },
        "/settings/projects": {
            "get": {
                "summary": "List user projects",
                "responses": {
                    "200": {
                        "description": "Array of projects"
                    }
                }
            },
            "post": {
                "summary": "Create project",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "title": {
                                        "type": "string"
                                    },
                                    "role": {
                                        "type": "string"
                                    },
                                    "description": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "title"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Created"
                    }
                }
            },
            "delete": {
                "summary": "Delete project",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "projectId": {
                                        "type": "integer"
                                    }
                                },
                                "required": [
                                    "projectId"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Deleted"
                    }
                }
            }
        },
        "/send-casting": {
            "post": {
                "summary": "Public casting submission",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Created"
                    }
                }
            }
        },
        "/upload": {
            "post": {
                "summary": "Upload generic file",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "file": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "required": [
                                    "file"
                                ]
                            }
