:root{
  --bg: #0f0f12;
  --card: #181a1f;
  --text: #eaecef;
  --muted: #9aa4b2;
  --accent: #2f81f7;
  --border: #262a33;
}

html,body{height:100%;}
*{box-sizing:border-box;}
body{
  margin:0;
  font-family: system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, 'Helvetica Neue', Arial, 'Noto Sans', 'Apple Color Emoji','Segoe UI Emoji','Segoe UI Symbol',sans-serif;
  background: var(--bg);
  color: var(--text);
}

.container{max-width:760px; margin:0 auto; padding:16px 16px 24px;}

.header{display:flex; gap:12px; align-items:center; margin-bottom:12px;}
.logo{font-size:28px;}
.title h1{font-size:18px; margin:0 0 2px;}
.subtitle{margin:0; color:var(--muted); font-size:13px;}

.field{background:var(--card); border:1px solid var(--border); border-radius:14px; padding:12px 12px 10px; margin:12px 0;}
.field label{display:block; color:var(--muted); font-size:12px; margin-bottom:6px;}
.field input,
.field textarea{
  width:100%; border:1px solid var(--border); background:#0e1014; color:var(--text);
  border-radius:10px; padding:10px 12px; font-size:14px; outline:none;
}
.field textarea{resize:vertical; min-height:160px;}
.field .hint{margin-top:6px; color:var(--muted); font-size:12px;}

.actions{display:flex; gap:10px; margin:16px 0 8px; flex-wrap:wrap;}
.actions button{
  flex:1 1 260px; padding:12px 14px; font-size:15px; border-radius:12px; border:1px solid var(--border);
  background:var(--accent); color:#fff; cursor:pointer;
}
.actions button#btn-copy{ background:#23262e; color:var(--text); }

.warn{font-size:12px; color:#ffcf66; margin:4px 2px 0;}

.footer{display:flex; justify-content:center; margin-top:10px;}
.footer .ghost{
  background:transparent; color:var(--muted); border:1px dashed var(--border); padding:10px 14px; border-radius:12px; cursor:pointer;
}

/* Telegram theme sync */
.tg-theme-light{
  --bg:#ffffff; --card:#f6f7f9; --text:#101318; --muted:#5d6470; --accent:#2f81f7; --border:#e2e7ef;
  .field input, .field textarea{ background:#fff; }
}